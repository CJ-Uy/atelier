{
	"compatibility_date": "2026-03-27",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "atelier",
	"account_id": "8527ec1369d46f55304a6f59ab5356e4",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atelier",
			"database_id": "a5df7c83-97e4-48c3-a9e3-17f3c805b6f4"
		}
	],
	"observability": {
		"enabled": true
	},
	"env": {
		"beta": {
			"name": "atelier-beta",
			"account_id": "8527ec1369d46f55304a6f59ab5356e4",
			"workers_dev": false,
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "atelier",
					"database_id": "a5df7c83-97e4-48c3-a9e3-17f3c805b6f4"
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "02563cfe7ad145a8b805f27e5dd928ec"
				}
			],
			"routes": [
				{ "pattern": "beta.cjuy.dev", "custom_domain": true }
			]
		}
	}
}

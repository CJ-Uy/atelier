---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Navbar from '../components/shared/Navbar.astro';
import DotIndicator from '../components/home/DotIndicator.svelte';
import CornerMarks from '../components/home/CornerMarks.astro';
import EdgeNotes from '../components/home/EdgeNotes.astro';
import HomeOutro from '../components/home/HomeOutro.svelte';
import FacetDiagram from '../components/home/FacetDiagram.svelte';
import { SECTIONS } from '../components/home/sections';

interface Props {
  title?: string;
  description?: string;
  /** Set to true for the home page (enables scroll-container, dot indicator, grid morphing) */
  isHome?: boolean;
}
const {
  title = 'Atelier — Charles',
  description = 'Portfolio of Charles — developer, musician, and creative.',
  isHome = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&family=Noto+Sans+Tagalog&display=swap"
      rel="stylesheet"
    />
    {isHome && <script is:inline src="/face-data.js" defer></script>}
  </head>
  <body class:list={[{ 'page-home': isHome }]}
    style={!isHome ? 'display:flex;flex-direction:column;min-height:100vh;' : ''}>
    {isHome && (
      <>
        <!-- Ink texture + radial vignette: home only -->
        <div class="ink-texture" aria-hidden="true"></div>
        <div class="grid-vignette" aria-hidden="true"></div>
        <!-- Grid canvas: home only (non-home uses CSS graph paper) -->
        <canvas
          id="grid-canvas"
          style="position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;"
          aria-hidden="true"
        ></canvas>
        <!-- Inked annotation layer over the grid (sits below the hero text) -->
        <FacetDiagram client:only="svelte" />
        <!-- Registration brackets at the four corners -->
        <CornerMarks />
        <!-- Left-edge editorial marginalia (desktop only) -->
        <EdgeNotes />
        <!-- Vermilion scroll-progress hairline along the top edge -->
        <div class="scroll-progress" aria-hidden="true"></div>
      </>
    )}

    <!-- z-index 100: Navbar (hidden on non-home — pages render their own .wp-nav) -->
    {isHome && <Navbar />}

    {isHome && (
      <main style="position:fixed;inset:0;z-index:2;pointer-events:none;">
        <slot />
      </main>
    )}

    {isHome && <DotIndicator client:only="svelte" />}

    {isHome && (
      <div class="scroll-container">
        {SECTIONS.map((s) => (
          <div
            class="scroll-section"
            data-section-id={String(s.id)}
            data-grid-state={s.gridState}
            aria-hidden="true"
          />
        ))}
        <!-- Closing band — bridges to the Works page -->
        <div class="outro-wrap">
          <HomeOutro client:visible />
        </div>
      </div>
    )}

    {!isHome && <slot />}

    <!-- Grid engine bootstrap: home only (canvas doesn't exist on other pages) -->
    <script>
      import { GridEngine } from '../lib/grid/GridEngine';
      import { AmbientAnimation } from '../lib/grid/AmbientAnimation';
      import { ScrollOrchestrator } from '../lib/grid/ScrollOrchestrator';
      import { SECTIONS } from '../components/home/sections';

      const canvas = document.getElementById('grid-canvas') as HTMLCanvasElement;
      if (canvas) {
        const engine = new GridEngine(canvas);
        const ambient = new AmbientAnimation(engine);
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reduceMotion) {
          // Freeze the time uniform (no idle drift) but keep rendering so the
          // scroll-driven morph — user-initiated motion — still works.
          const renderStill = () => { engine.render(); requestAnimationFrame(renderStill); };
          requestAnimationFrame(renderStill);
        } else {
          ambient.start();
        }

        const scrollContainer = document.querySelector('.scroll-container') as HTMLElement | null;
        if (scrollContainer) {
          const orchestrator = new ScrollOrchestrator(engine, SECTIONS);

          window.addEventListener('atelier:jump-to-section', (e) => {
            const detail = (e as CustomEvent<{ index: number }>).detail;
            orchestrator.goToSection(detail.index);
          });

          // ── Opening ritual: the dot grid develops Charles's portrait, then
          // holds. graphPaper → face over ~2.4s, eased. A real scroll/key aborts
          // and hands control to the scroll-driven morph. The orchestrator is
          // only wired AFTER the ritual settles or is interrupted, so the two
          // never fight over `progress`.
          let ritualDone = false;
          let ritualRaf = 0;
          const startTimer = reduceMotion ? 0 : window.setTimeout(runRitual, 380);
          if (reduceMotion) {
            // No develop animation: rest on the portrait immediately.
            ritualDone = true;
            engine.setCurrent('face');
            engine.setProgress(0);
            orchestrator.init(scrollContainer);
          }

          function finishRitual() {
            if (ritualDone) return;
            ritualDone = true;
            cancelAnimationFrame(ritualRaf);
            clearTimeout(startTimer);
            scrollContainer!.removeEventListener('wheel', abortRitual);
            scrollContainer!.removeEventListener('touchstart', abortRitual);
            window.removeEventListener('keydown', onKey);
            // Promote face → current so the scroll morph starts from the portrait.
            engine.setCurrent('face');
            engine.setProgress(0);
            orchestrator.init(scrollContainer!);
          }

          // ── Grid + hero fade-out as the closing band scrolls in. The last
          // facet sits at fraction = SECTIONS.length - 1; past it the grid and
          // nameplate dissolve so the outro reads on clean paper.
          const heroLayer = document.querySelector('main') as HTMLElement | null;
          const cornerMarks = document.querySelector('.corner-marks') as HTMLElement | null;
          const edgeNotes = document.querySelector('.edge-notes') as HTMLElement | null;
          const progressBar = document.querySelector('.scroll-progress') as HTMLElement | null;
          const heroMax = SECTIONS.length - 1;
          scrollContainer!.addEventListener('scroll', () => {
            const h = scrollContainer!.clientHeight;
            if (!h) return;
            const fraction = scrollContainer!.scrollTop / h;
            const fade = fraction <= heroMax ? 1 : Math.max(0, 1 - (fraction - heroMax));
            canvas!.style.opacity = String(fade);
            if (cornerMarks) cornerMarks.style.opacity = String(fade);
            if (edgeNotes) edgeNotes.style.opacity = String(fade);
            if (heroLayer) {
              heroLayer.style.opacity = String(fade);
              heroLayer.style.visibility = fade < 0.02 ? 'hidden' : 'visible';
            }
            if (progressBar) {
              const max = scrollContainer!.scrollHeight - scrollContainer!.clientHeight;
              progressBar.style.transform = `scaleX(${max > 0 ? scrollContainer!.scrollTop / max : 0})`;
            }
          }, { passive: true });

          // ── Keyboard wayfinding — arrows/page keys step the facets,
          // Home/End jump to the ends. The outro (one viewport past the last
          // facet) is reachable so its links stay in the keyboard flow.
          window.addEventListener('keydown', (e) => {
            if (!ritualDone || e.altKey || e.ctrlKey || e.metaKey) return;
            const t = e.target as HTMLElement | null;
            if (t && ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName)) return;
            const h = scrollContainer!.clientHeight;
            if (!h) return;
            const last = SECTIONS.length - 1;
            const inOutro = scrollContainer!.scrollTop / h > last + 0.5;
            if (e.key === 'Home') { e.preventDefault(); orchestrator.goToSection(0); return; }
            if (e.key === 'End') { e.preventDefault(); orchestrator.goToSection(last); return; }
            let dir = 0;
            if (['ArrowDown', 'PageDown'].includes(e.key) || (e.key === ' ' && !e.shiftKey)) dir = 1;
            else if (['ArrowUp', 'PageUp'].includes(e.key) || (e.key === ' ' && e.shiftKey)) dir = -1;
            if (!dir) return;
            e.preventDefault();
            if (dir === 1 && orchestrator.currentIndex >= last && !inOutro) {
              scrollContainer!.scrollTo({ top: (last + 1) * h, behavior: reduceMotion ? 'auto' : 'smooth' });
            } else if (dir === -1 && inOutro) {
              orchestrator.goToSection(last);
            } else {
              orchestrator.goToSection(orchestrator.currentIndex + dir);
            }
          });

          function abortRitual() {
            if (ritualDone) return;
            // jump the develop to fully-formed, then hand off
            engine.setCurrent('graphPaper');
            engine.setTarget('face');
            engine.setProgress(1);
            finishRitual();
          }

          function onKey(e: KeyboardEvent) {
            if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' '].includes(e.key)) abortRitual();
          }

          function runRitual() {
            engine.setCurrent('graphPaper');
            engine.setTarget('face');
            const dur = 2400;
            const ease = (t: number) =>
              t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
            const t0 = performance.now();
            scrollContainer!.addEventListener('wheel', abortRitual, { passive: true });
            scrollContainer!.addEventListener('touchstart', abortRitual, { passive: true });
            window.addEventListener('keydown', onKey);
            const step = (now: number) => {
              if (ritualDone) return;
              if (scrollContainer!.scrollTop > 2) { abortRitual(); return; }
              const t = Math.min((now - t0) / dur, 1);
              engine.setProgress(ease(t));
              if (t < 1) ritualRaf = requestAnimationFrame(step);
              else finishRitual();
            };
            ritualRaf = requestAnimationFrame(step);
          }
        }

        document.addEventListener('pointermove', (e) => {
          engine.setCursorPx(e.clientX, e.clientY);
        }, { passive: true });
        document.addEventListener('pointerleave', () => {
          engine.setCursorInactive();
        });
      }
    </script>
  </body>
</html>

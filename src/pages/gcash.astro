---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="GCash summoning circle — CJ-Uy"
  description="yes this is my actual gcash"
>
  <main class="gcash-page">
    <h1>GCash summoning circle</h1>

    <a class="qr-link" href="/gcash-qr.jpg" target="_blank" rel="noopener" aria-label="Open the original GCash QR image">
      <img src="/gcash-qr.jpg" width="656" height="1312" alt="Charles's original GCash InstaPay QR code" fetchpriority="high" />
    </a>

    <div class="buttons" aria-label="GCash QR actions">
      <a class="button save" id="save-qr" href="/gcash-qr.jpg" target="_blank" rel="noopener">↓ save QR to Photos</a>
      <a class="button" href="gcash://com.mynt.gcash/app">open GCash app ↗</a>
    </div>
    <button class="candle-button" id="candle-button" type="button"><span>🕯️ LIGHT A CANDLE</span><small>and help me summon more GCash plz</small></button>
    <div class="candles"><span id="candle-row" aria-hidden="true"></span><span id="candle-caption" aria-live="polite"></span></div>

    <img class="meme" src="/gcash-meme.png" width="1254" height="1254" loading="lazy" alt="GCash summoning ritual meme with candles, a praying dog, a piggy bank, and bottom text" />
    <p class="footer"><a href="https://cjuy.dev">back to my actual site</a></p>
  </main>
</BaseLayout>

<script>
  const saveQr = document.querySelector<HTMLAnchorElement>('#save-qr');
  if (saveQr) {
    const onPhone = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (!onPhone) {
      saveQr.textContent = '↓ save QR';
      saveQr.download = 'CJ-Uy-GCash-QR.jpg';
      saveQr.removeAttribute('target');
    } else if (navigator.canShare) {
      fetch('/gcash-qr.jpg')
        .then(async (response) => {
          if (!response.ok) throw new Error('QR image unavailable');
          const file = new File([await response.blob()], 'CJ-Uy-GCash-QR.jpg', { type: 'image/jpeg' });
          if (!navigator.canShare({ files: [file] })) return;
          saveQr.dataset.shareReady = 'true';
          saveQr.addEventListener('click', (event) => {
            event.preventDefault();
            navigator.share({ files: [file] }).catch((error) => {
              if (error?.name !== 'AbortError') window.location.href = '/gcash-qr.jpg';
            });
          });
        })
        .catch(() => {});
    }
  }

  const button = document.querySelector<HTMLButtonElement>('#candle-button');
  const row = document.querySelector<HTMLElement>('#candle-row');
  const caption = document.querySelector<HTMLElement>('#candle-caption');

  if (button && row && caption) {
    let candles = 0;
    try {
      const saved = Number.parseInt(localStorage.getItem('gcash-candles') ?? '0', 10);
      if (Number.isFinite(saved)) candles = Math.max(0, Math.min(saved, 24));
    } catch { /* Storage can be unavailable. */ }
    const render = () => {
      row.textContent = '🕯️'.repeat(candles);
      caption.textContent = candles ? `${candles} candle${candles === 1 ? '' : 's'} lit. still waiting for GCash.` : '';
      button.disabled = candles === 24;
      if (candles === 24) button.textContent = 'the altar is full. salamat 🙏';
    };
    render();
    button.addEventListener('click', () => {
      candles += 1;
      try { localStorage.setItem('gcash-candles', String(candles)); } catch { /* The button still works. */ }
      render();
    });
  }
</script>

<style>
  :global(html:has(.gcash-page)) { scrollbar-gutter: auto; background: white; }
  :global(body:has(.gcash-page)) { background: white; }
  .gcash-page {
    position: relative; z-index: 1; min-height: 100dvh; padding: 42px 16px 60px;
    background: #fff; color: #111; text-align: center;
    font-family: Arial, sans-serif;
  }
  h1 {
    width: min(100%, 520px); margin: 0 auto 18px; color: #075ce6; text-align: left;
    font: bold clamp(2rem, 6vw, 3.5rem)/1.05 Arial, sans-serif;
    text-shadow: 3px 3px #ffe500; transform: translateX(-30px) rotate(-2deg);
    animation: badly-colored 2s steps(1, end) infinite;
  }
  .qr-link { display: block; width: min(100%, 320px); margin: auto; }
  .qr-link img { display: block; width: 100%; height: auto; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 620px; margin: 20px auto 0; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 9px 14px; border: 1px solid #111; border-radius: 3px; color: #111; background: white; font: 700 13px/1.2 Arial, sans-serif; text-decoration: none; cursor: pointer; }
  .button:hover { background: #edf4ff; }
  .button.save { color: #fff; background: #075ce6; border-color: #075ce6; }
  .button.save:hover { background: #0049bd; }
  .button:disabled { color: #777; cursor: default; }
  .candle-button { display: grid; gap: 4px; width: min(100%, 430px); min-height: 92px; margin: 26px auto 12px; padding: 12px 18px; border: 3px solid #111; border-radius: 4px; background: #ffeb00; color: #111; box-shadow: 7px 7px #075ce6; transform: rotate(-1deg); font: 900 clamp(18px, 5vw, 27px)/1.1 Arial, sans-serif; cursor: pointer; }
  .candle-button small { font-size: clamp(12px, 3.3vw, 17px); }
  .candle-button:hover { background: #ffca00; }
  .candle-button:disabled { background: #eee; color: #555; cursor: default; }
  .qr-link:focus-visible, .button:focus-visible, .candle-button:focus-visible, .footer a:focus-visible { outline: 3px solid #075ce6; outline-offset: 4px; }
  .candles { display: grid; justify-items: center; gap: 4px; }
  #candle-row:not(:empty) { max-width: 540px; margin-top: 15px; font-size: 27px; line-height: 1.4; overflow-wrap: anywhere; }
  #candle-caption:not(:empty) { color: #666; font-size: 12px; }
  .meme { display: block; width: min(100%, 550px); height: auto; margin: 60px auto 0; }
  .footer { margin: 25px auto 0; color: #666; font-size: 12px; line-height: 1.6; }
  .footer a { color: #075ce6; }
  @keyframes badly-colored {
    0%, 100% { color: #075ce6; text-shadow: 3px 3px #ffe500; }
    25% { color: #f10083; text-shadow: 3px 3px #00ddff; }
    50% { color: #139e00; text-shadow: 3px 3px #ff8c00; }
    75% { color: #a100e8; text-shadow: 3px 3px #71ff00; }
  }
  @media (max-width: 450px) {
    .gcash-page { padding-top: 30px; }
    h1 { transform: translateX(-8px) rotate(-2deg); }
    .qr-link { width: min(100%, 290px); }
    .meme { margin-top: 48px; }
  }
  @media (prefers-reduced-motion: reduce) { h1 { animation: none; } }
</style>

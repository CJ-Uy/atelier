---
// src/pages/contact.astro — Contact page using React (faithful port of contact-page.jsx)
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from '../components/contact/ContactPage';
---

<BaseLayout title="Contact — Atelier" description="Every circle on this site was cast for something. This one summons me.">
  <ContactPage client:only="react" />
</BaseLayout>

<!-- CSS from Contact.html exactly: shared nav/header, stage, charge animations, footer -->
<style is:global>
  /* ── Animations ── */
  @keyframes cmFadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes cmPulse  { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.3; transform: scale(0.7); } }

  /* charge lines */
  @keyframes cmFlow { to { stroke-dashoffset: -16; } }
  .cm-flow { stroke-dasharray: 2 6; animation: cmFlow 0.5s linear infinite; opacity: 0.95; }
  /* spark halo */
  @keyframes cmSpark { 0% { opacity: 0.9; r: 3px; } 100% { opacity: 0; r: 10px; } }
  .cm-spark { animation: cmSpark 0.9s ease-out infinite; }
  /* pulse ring */
  @keyframes cmPulseRing { 0% { opacity: 0.85; transform: scale(0.7); } 100% { opacity: 0; transform: scale(1.5); } }
  .cm-pulsering { transform-box: fill-box; transform-origin: center; animation: cmPulseRing 1.1s ease-out infinite; }

  /* ── Shared nav (also used by Works) ── */
  .wp-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 32px; mix-blend-mode: multiply;
  }
  .wp-brand {
    font-family: 'Instrument Serif', Georgia, serif; font-style: italic;
    font-size: 22px; color: #0a0a0a; text-decoration: none; letter-spacing: -0.02em;
  }
  .wp-links { display: flex; gap: 22px; align-items: center; }
  .wp-link {
    font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; color: #0a0a0a;
    text-decoration: none; opacity: 0.5; transition: opacity 0.2s;
  }
  .wp-link:hover { opacity: 1; }
  .wp-link.active { opacity: 1; border-bottom: 1.5px solid #0a0a0a; padding-bottom: 2px; }

  /* ── Shared page header ── */
  .ph-header {
    position: relative; z-index: 1; text-align: center;
    max-width: 720px; margin: 0 auto; padding: 124px 32px 8px;
    animation: cmFadeUp 700ms cubic-bezier(0.4,0,0.2,1) both;
  }
  .ph-circlemark { display: flex; justify-content: center; margin-bottom: 24px; opacity: 0.9; }
  .ph-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px; letter-spacing: 0.34em; font-weight: 700;
    opacity: 0.55; text-transform: uppercase; margin-bottom: 18px;
  }
  .ph-title {
    font-family: 'Instrument Serif', Georgia, serif; font-weight: 400;
    font-size: clamp(2.8rem, 6.5vw, 4.6rem); letter-spacing: -0.04em;
    line-height: 0.98; margin-bottom: 20px; color: #0a0a0a;
  }
  .ph-sub {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(0.74rem, 1vw, 0.82rem); line-height: 1.65; color: #454545;
    max-width: 52ch; margin: 0 auto; letter-spacing: 0.01em;
  }

  /* ── Status indicator ── */
  .cm-status {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 22px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    border: 1.2px solid #0a0a0a; padding: 8px 14px; color: #0a0a0a;
  }
  .cm-dot {
    display: inline-block;
    width: 8px; height: 8px; border-radius: 50%; background: #dc3522;
    animation: cmPulse 1.8s ease-in-out infinite;
  }

  /* ── Stage ── */
  .cm-stage {
    position: relative; z-index: 1; flex: 1;
    display: flex; align-items: center; justify-content: center;
    padding: 24px 24px 40px;
    animation: cmFadeUp 800ms cubic-bezier(0.4,0,0.2,1) 120ms both;
  }

  /* ── Mobile rows ── */
  .cm-row {
    display: flex; align-items: center; gap: 16px;
    padding: 16px 6px; border-bottom: 1px solid rgba(10,10,10,0.14);
    transition: background 160ms ease, padding-left 160ms ease;
  }
  .cm-row:first-child { border-top: 1px solid rgba(10,10,10,0.14); }
  .cm-row:hover { background: rgba(10,10,10,0.03); padding-left: 12px; }
  .cm-row-disc {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1.4px solid #0a0a0a; background: #faf9f6; font-weight: 600; color: #0a0a0a;
  }

  /* ── Footer ── */
  .cm-foot {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: center; gap: 14px;
    padding: 24px 32px 40px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px; letter-spacing: 0.24em; font-weight: 600; opacity: 0.5; text-transform: uppercase;
  }
  .cm-foot span:first-child, .cm-foot span:last-child { width: 30px; height: 1px; background: #0a0a0a; opacity: 0.5; display: inline-block; }

  @media (max-width: 600px) {
    .ph-header { padding-top: 100px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPage from '../components/contact/ContactPage';
---

<BaseLayout title="Contact — Atelier" description="Every circle on this site was cast for something. This one summons me.">
  <ContactPage client:load />
</BaseLayout>

<style is:global>
  .cm-header { padding-top: 116px; }
  .cm-header .ph-sub { font-size: clamp(0.875rem, 1.1vw, 0.95rem); line-height: 1.75; }
  .cm-status {
    display: inline-flex; align-items: center; gap: 10px; margin-top: 22px;
    max-width: 100%; padding: 10px 14px; border: 1px solid var(--ink);
    font: 600 10px/1.6 var(--font-mono); letter-spacing: 0.12em;
  }
  .cm-dot { flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--vermilion); }
  .cm-stage {
    position: relative; z-index: 1; flex: 1; width: 100%;
    display: flex; flex-direction: column; align-items: center;
    padding: 16px 32px 0;
  }
  .cm-apparatus { position: relative; width: min(100%, 680px); aspect-ratio: 1; animation: cmApparatusIn var(--motion-reveal) var(--ease-settle) 120ms backwards; }
  @keyframes cmApparatusIn { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: scale(1); } }
  .cm-connections { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .cm-flow { stroke: var(--vermilion); stroke-width: 1.2; stroke-dasharray: 1; stroke-dashoffset: 0; animation: cmConnect 420ms var(--ease-settle) var(--line-delay) backwards; opacity: 0.7; }
  @keyframes cmConnect { from { stroke-dashoffset: 1; opacity: 0; } to { stroke-dashoffset: 0; opacity: 0.7; } }
  .cm-circle { position: absolute; inset: 22.5%; pointer-events: none; }
  .cm-core {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 102px; height: 102px; pointer-events: none;
  }
  .cm-monogram {
    display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;
    border-radius: 50%; background: var(--paper); border: 1.5px solid var(--ink);
    font: 27px/1 var(--font-serif); transition: border-color 200ms ease;
  }
  .cm-core-label {
    display: block; margin-top: 10px; text-align: center;
    font: 600 9px/1.5 var(--font-mono); text-transform: uppercase; letter-spacing: 0.12em;
    color: #606060;
  }
  .is-charging .cm-monogram { border-color: var(--vermilion); }
  .is-charging .cm-core-label { color: var(--vermilion); }
  .cm-sigil {
    position: absolute; z-index: 2; transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    width: 148px; min-height: 96px; color: var(--ink); text-decoration: none;
    text-align: center; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  }
  .cm-sigil-disc {
    position: relative;
    display: flex; align-items: center; justify-content: center; width: 56px; height: 56px;
    flex-shrink: 0; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--paper);
    font: 600 18px/1 var(--font-mono);
    transition: background-color var(--motion-feedback) ease, border-color var(--motion-feedback) ease, color var(--motion-feedback) ease, transform 220ms var(--ease-settle);
    animation: cmNodePlace 480ms var(--ease-settle) var(--node-delay) backwards;
  }
  @keyframes cmNodePlace { from { opacity: 0; transform: translateY(-8px) scale(0.92); } to { opacity: 1; transform: translateY(0) scale(1); } }
  .cm-sigil-disc::after { content: ''; position: absolute; inset: -6px; border: 1px solid var(--vermilion); border-radius: 50%; opacity: 0; transform: scale(1.16); transition: opacity 220ms ease, transform 360ms var(--ease-settle); }
  .is-active .cm-sigil-disc::after { opacity: 0.45; transform: scale(1); }
  .cm-glyph { font: 26px/1 Georgia, serif; }
  .is-active .cm-sigil-disc { background: var(--vermilion); border-color: var(--vermilion); color: var(--paper); transform: scale(1.08); }
  .cm-sigil-label { margin-top: 9px; font: 600 11px/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .cm-sigil-handle { margin-top: 2px; font: italic 15px/1.3 var(--font-serif); color: #555; white-space: nowrap; }
  .cm-label-short { display: none; }
  .cm-channel-status { width: min(100%, 520px); min-height: 108px; padding-top: 12px; text-align: center; }
  .cm-channel-status p { margin: 0; overflow-wrap: anywhere; font: 13px/1.7 var(--font-mono); color: #555; }
  .cm-apparatus[data-paused="true"] * { animation-play-state: paused !important; }
  @media (max-width: 819px), (max-height: 500px) and (orientation: landscape) {
    .cm-header { padding: 104px 24px 8px; }
    .cm-header .ph-eyebrow { font-size: 9px; letter-spacing: 0.16em; margin-bottom: 16px; }
    .cm-header .ph-title { font-size: clamp(3.2rem, 11vw, 4.6rem); margin-bottom: 18px; }
    .cm-status { font-size: 9px; letter-spacing: 0.06em; margin-top: 20px; }
    .cm-stage { padding: 24px 20px 0; }
    .cm-apparatus { max-width: 440px; }
    .cm-circle { inset: 19%; }
    .cm-core { width: 70px; height: 70px; }
    .cm-monogram { font-size: 23px; }
    .cm-core-label { font-size: 8px; letter-spacing: 0.04em; margin-top: 7px; }
    .cm-sigil { width: 76px; min-height: 80px; }
    .cm-sigil-disc { width: 48px; height: 48px; font-size: 15px; }
    .cm-glyph { font-size: 24px; }
    .cm-sigil-label { margin-top: 7px; font-size: 10px; letter-spacing: 0.02em; }
    .cm-sigil-handle, .cm-label-full { display: none; }
    .cm-label-short { display: inline; }
    .cm-channel-status { padding-top: 20px; min-height: 120px; }
    .cm-foot { padding-top: 12px; text-align: center; line-height: 1.8; letter-spacing: 0.12em; }
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .cm-apparatus { max-width: max(300px, calc(100dvh - 64px)); }
  }
  @media (max-width: 359px) {
    .cm-stage { padding-inline: 14px; }
    .cm-header { padding-inline: 20px; }
    .cm-sigil { width: 66px; }
    .cm-status { font-size: 8px; padding-inline: 10px; }
  }
</style>

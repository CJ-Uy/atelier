---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesIndex from '../../components/notes/NotesIndex.vue';
import { getCollection } from 'astro:content';

const posts = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((e) => ({
    slug: e.id,
    title: e.data.title,
    date: e.data.date.toISOString(),
    excerpt: e.data.excerpt,
    tags: e.data.tags,
  }));
---

<BaseLayout
  title="Notes — Atelier"
  description="Observations from the workbench — on craft, code, and whatever refuses to stay in the margins."
>
  <NotesIndex posts={posts} client:visible />
</BaseLayout>

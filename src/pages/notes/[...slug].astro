---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
---

<BaseLayout
  title={`${entry.data.title} — Field Notes`}
  description={entry.data.excerpt}
>
  <div class="note-page">
    <!-- Nav -->
    <nav class="wp-nav" aria-label="Main navigation">
      <a href="/" class="wp-brand">atelier</a>
      <div class="wp-links">
        <a href="/" class="wp-link">Home</a>
        <a href="/works" class="wp-link">Works</a>
        <a href="/notes" class="wp-link active">Notes</a>
        <a href="/contact" class="wp-link">Contact</a>
      </div>
    </nav>

    <!-- Post header -->
    <header class="ph-header note-header">
      <div class="ph-eyebrow">✦ LOG · FIELD NOTES ✦</div>
      <h1 class="ph-title">{entry.data.title}</h1>
      <div class="note-meta">
        <span class="note-date">{dateStr}</span>
        <div class="note-tags">
          {entry.data.tags.map((tag) => (
            <span class="note-tag">{tag}</span>
          ))}
        </div>
      </div>
    </header>

    <!-- Post body -->
    <article class="note-article">
      <div class="note-prose">
        <Content />
      </div>
      <a href="/notes" class="note-back">← all notes</a>
    </article>

    <!-- Footer -->
    <footer class="cm-foot">
      <span></span>
      FIELD NOTES · ATELIER
      <span></span>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  @keyframes cmFadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .note-page {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .note-header { text-align: left; max-width: 680px; }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .note-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #dc3522;
  }

  .note-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .note-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.45;
    border: 1px solid rgba(10,10,10,0.25);
    padding: 2px 7px;
  }

  /* ── Prose ── */
  .note-article {
    flex: 1;
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
    padding: 0 32px 48px;
    animation: cmFadeUp 700ms cubic-bezier(0.4,0,0.2,1) 100ms both;
  }

  .note-prose {
    border-top: 1.6px solid #0a0a0a;
    padding-top: 32px;
    margin-bottom: 40px;
  }

  .note-prose h2 {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.3rem, 2.5vw, 1.7rem);
    letter-spacing: -0.02em;
    color: #0a0a0a;
    margin: 2em 0 0.6em;
  }

  .note-prose h3 {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0a0a0a;
    margin: 1.8em 0 0.5em;
  }

  .note-prose p {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.75;
    color: #1a1a1a;
    margin-bottom: 1.2em;
  }

  .note-prose pre {
    background: rgba(10,10,10,0.04);
    border: 1.2px solid rgba(10,10,10,0.15);
    padding: 16px 20px;
    overflow-x: auto;
    margin: 1.4em 0;
  }

  .note-prose code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.78rem;
  }

  .note-prose p code {
    background: rgba(10,10,10,0.06);
    padding: 1px 5px;
  }

  .note-prose a {
    color: #dc3522;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .note-prose ul, .note-prose ol {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.75;
    color: #1a1a1a;
    padding-left: 1.4em;
    margin-bottom: 1.2em;
  }

  .note-prose hr {
    border: none;
    border-top: 1px solid rgba(10,10,10,0.15);
    margin: 2em 0;
  }

  /* ── Back link ── */
  .note-back {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0a0a0a;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.15s;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .note-back:hover { opacity: 1; }

  @media (max-width: 600px) {
    .note-article { padding: 0 20px 40px; }
  }
</style>
